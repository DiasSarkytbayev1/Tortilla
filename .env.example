# Copy to .env and adjust as needed. Never commit the real .env.

# Postgres (read by both the db container and the backend container)
DB_NAME=tortilla_db
DB_USER=tortilla_user
DB_PASSWORD=tortilla_pass

# Host-side port mappings. Change these if you already have a service on these
# ports — only the host port is changed; the in-container ports are fixed.
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Display / locale (from design-doc §5)
CURRENCY_SYMBOL=€
CHAIN_TZ=Europe/Madrid

# Auth
ENV=dev
# Generate a real one for production: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-prod-only-dev-default
SESSION_TTL_S=86400
