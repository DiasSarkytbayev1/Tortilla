# Copy to .env and adjust as needed. Never commit the real .env.

# Postgres (read by both the db container and the backend container)
DB_NAME=tortilla_db
DB_USER=tortilla_user
DB_PASSWORD=tortilla_pass

# Host-side port mappings. Change these if you already have a service on 5432
# or 8000 — only the host port is changed; the in-container ports are fixed.
DB_PORT=5432
BACKEND_PORT=8000

# Display / locale (from design-doc §5)
CURRENCY_SYMBOL=€
CHAIN_TZ=Europe/Madrid
